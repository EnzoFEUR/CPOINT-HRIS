{
  "name": "hris-enterprise",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise HRIS Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "test:documents": "node --test tests/document*.test.mjs",
    "test:offline": "node --test tests/offline*.test.mjs",
    "install:all": "npm install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
